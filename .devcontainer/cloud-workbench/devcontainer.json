{
  "name": "Carb 云端工作台",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5-24-bookworm",
  "remoteUser": "node",
  "forwardPorts": [4180],
  "portsAttributes": {
    "4180": { "label": "Carb 网页工作台", "onAutoForward": "notify" }
  },
  "postCreateCommand": "npm ci --prefix cloud-workbench --omit=dev",
  "postAttachCommand": "bash cloud-workbench/start-codespace.sh"
}
